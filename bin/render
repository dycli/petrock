#!/usr/bin/env bash
# render BOARD OUT.png X0 Y0 X1 Y1 [layers] : crop a board region to PNG (mm coords)
set -e
board=$1 out=$2 x0=$3 y0=$4 x1=$5 y1=$6 layers=${7:-B.Cu,F.Cu,Edge.Cuts,F.Courtyard,F.Silkscreen}
tmp=$(mktemp -d)
"$(dirname "$(readlink -f "$0")")/kcli" pcb export svg --mode-single --layers "$layers" --exclude-drawing-sheet --page-size-mode 0 -o "$tmp/b.svg" "$board" >/dev/null 2>&1
python3 - "$tmp/b.svg" "$x0" "$y0" "$x1" "$y1" <<'PY'
import re,sys
p,x0,y0,x1,y1=sys.argv[1],*map(float,sys.argv[2:])
s=open(p).read()
s=re.sub(r'viewBox="[^"]*"', f'viewBox="{x0} {y0} {x1-x0} {y1-y0}"', s, count=1)
s=re.sub(r'(<svg[^>]*?)width="[^"]*"', rf'\1width="{(x1-x0)*20}"', s, count=1)
s=re.sub(r'(<svg[^>]*?)height="[^"]*"', rf'\1height="{(y1-y0)*20}"', s, count=1)
open(p,'w').write(s)
PY
"$(dirname "$(readlink -f "$0")")/../.nix/librsvg/bin/rsvg-convert" -b white "$tmp/b.svg" -o "$out"
rm -rf "$tmp"
