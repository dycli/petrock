#!/usr/bin/env bash
# Python with KiCad's pcbnew module, from the GC-rooted links in .nix/ (see bin/setup).
N="$(dirname "$(readlink -f "$0")")/../.nix"
export PYTHONPATH=$N/kicad-base/lib/python3.14/site-packages:$N/numpy/lib/python3.14/site-packages
export KICAD10_FOOTPRINT_DIR=/dev/null
exec "$N/python/bin/python3.14" "$@" 2>&1 | grep -av -e "^swig/python detected" -e "GetWidth called" -e "Font .* not found"; exit ${PIPESTATUS[0]}
